# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov
.vitest-cache/

# next.js
/.next/
/out/
.turbo/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets!)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eslint
.eslintcache

# claude AI workspace
.claude/

# generated docs & analysis artifacts. CRON.md is the exception: it is
# hand-maintained and has to match what cron-job.org is actually calling, so it
# is versioned with the routes it documents. A negation only works against
# /docs/* - git cannot re-include a file whose parent directory is excluded.
/docs/*
!/docs/CRON.md
google-tokens.txt

# generated ad creatives (regenerate with `npm run build:ads`)
/ad-creatives/

# local reference material
To the Point - Template.xlsx

# agent instruction files, rewritten by every `next dev` (see
# node_modules/next/dist/server/lib/generate-agent-files.js). Generated, not
# authored, so they are not versioned - agent behaviour here is driven by the
# operator's own global config instead.
/AGENTS.md
/CLAUDE.md
