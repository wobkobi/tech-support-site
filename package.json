{
  "name": "tech-support-site",
  "version": "5.18.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backfill:company:apply": "dotenv -e .env.local -- tsx scripts/backfill-contact-company.ts --apply",
    "backfill:company:dry": "dotenv -e .env.local -- tsx scripts/backfill-contact-company.ts",
    "backfill:review-asks:apply": "dotenv -e .env.local -- tsx scripts/backfill-review-ask-outcomes.ts --apply",
    "backfill:review-asks:dry": "dotenv -e .env.local -- tsx scripts/backfill-review-ask-outcomes.ts",
    "build": "next build",
    "build:ads": "tsx scripts/build-ads.ts",
    "build:all": "npm run build:icons && npm run build",
    "build:card": "npx tsx scripts/export-card-screenshot.ts",
    "build:icons": "tsx scripts/build-icons/index.ts",
    "build:poster": "npx tsx scripts/export-poster-screenshot.ts",
    "build:sign": "npx tsx scripts/export-sign-screenshot.ts",
    "build:social": "npx tsx scripts/export-social-screenshot.ts",
    "calibrate": "dotenv -e .env.local -- tsx scripts/calibrate-benchmarks.ts",
    "db:push": "prisma db push",
    "dev": "next dev",
    "eval:ai": "dotenv -e .env.local -- tsx scripts/eval-ai/index.ts",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,mjs,css,html,md,json,yml,yaml}\"",
    "postinstall": "prisma generate",
    "lint": "eslint --cache --max-warnings=0 \"{src,scripts}/**/*.{js,ts,jsx,tsx}\"",
    "lint:fix": "eslint --fix --cache \"{src,scripts}/**/*.{js,ts,jsx,tsx}\"",
    "prepare": "simple-git-hooks",
    "probe:meta": "dotenv -e .env.local -- tsx scripts/probe-meta.ts",
    "reconcile:times:apply": "dotenv -e .env.local -- tsx scripts/reconcile-booking-times.ts --apply",
    "reconcile:times:dry": "dotenv -e .env.local -- tsx scripts/reconcile-booking-times.ts",
    "settings:seed": "dotenv -e .env.local -- tsx scripts/seed-settings.ts",
    "smoke": "dotenv -e .env.local -- tsx scripts/smoke-test.ts",
    "start": "next start",
    "test": "tsx scripts/run-checks.ts",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "if ! find node_modules/.npm-update-stamp -mmin -1440 2>/dev/null | grep -q .; then npm update --package-lock-only --allow-remote=all --no-audit --no-fund && touch node_modules/.npm-update-stamp; fi && npm install --package-lock-only --allow-remote=all --no-audit --no-fund && git add package-lock.json package.json && npx lint-staged --max-arg-length 4096 && npm run typecheck && npm test",
    "pre-push": "npm run lint && npm run build && npm run smoke -- --skip-build"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "**/*.{css,html,json,md,mjs,yml,yaml}": "prettier --write",
    "prisma/schema.prisma": "prisma format --schema"
  },
  "browserslist": [
    "chrome >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "edge >= 93"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "openai": {
      "google-auth-library": "$google-auth-library"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/drive": "^27.0.0",
    "@googleapis/people": "^12.0.1",
    "@googleapis/sheets": "^18.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "6.19.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-holidays": "^3.37.0",
    "google-auth-library": "^11.3.1",
    "konva": "^10.9.0",
    "next": "^16.4.2",
    "openai": "^7.41.0",
    "pdf-lib": "^1.17.1",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-konva": "^19.3.2",
    "resend": "^6.34.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/google.maps": "^3.66.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "canvas": "^3.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-tailwind-canonical-classes": "^1.6.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "puppeteer": "^25.15.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "canvas": true,
    "esbuild": false,
    "prisma": true,
    "puppeteer": true,
    "simple-git-hooks": true,
    "unrs-resolver": true
  }
}
