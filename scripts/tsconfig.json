// scripts/tsconfig.json
// Standalone programme for the Node scripts and fixtures (run via tsx). They live
// outside the app's tsconfig `include`, so this config gives them their own
// type-checking context with the Node globals (`process`, etc.) loaded.
// `npm run typecheck` checks it after the app, so the hooks and CI catch a
// fixture that has drifted from the types it tests; `next build` ignores it.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
